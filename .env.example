# Copy to .env.local (dev) / set in hosting dashboard (prod). NEVER commit real values.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/raaj-aushadhi
# min 32 chars, random:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Public site URL (CSRF origin check ke liye, reverse proxy ke peeche zaroori)
SITE_URL=https://www.yourdomain.com
# Tumhare server ke aage kitne proxies hain (nginx=1, Cloudflare+nginx=2). Rate-limit IP ke liye.
TRUSTED_PROXY_HOPS=1
# Optional shipping rule
NEXT_PUBLIC_FREE_SHIPPING_ABOVE=999
NEXT_PUBLIC_SHIPPING_FEE=99
